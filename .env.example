# Wnesny (ونسني) environment configuration example.
# Copy to `.env` (never commit `.env`) and adjust the values.

# development | testing | production
WNESNY_ENV=development

# Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# Optional in development. When unset, SQLite is used at instance/wnesny_dev.db.
# Note: relative SQLite paths are resolved inside the instance/ folder.
# DATABASE_URL=sqlite:///wnesny_dev.db

# PostgreSQL example (requires installing a driver such as psycopg):
# DATABASE_URL=postgresql://wnesny_user:change-me@localhost:5432/wnesny

# Optional override for the test database (defaults to in-memory SQLite).
# TEST_DATABASE_URL=sqlite:///:memory:
