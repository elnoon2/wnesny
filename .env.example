# Wnesny Environment Configuration Example
FLASK_ENV=development
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production

# SQLite for local development:
DATABASE_URL=sqlite:///instance/wnesny_dev.db

# PostgreSQL example for production:
# DATABASE_URL=postgresql://wnesny_user:wnesny_password@localhost:5432/wnesny_db

# Testing SQLite database URI:
TEST_DATABASE_URL=sqlite:///:memory:
